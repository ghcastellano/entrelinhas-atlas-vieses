{
  "name": "atlas-dos-vieses",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test scripts/content.test.mjs",
    "test:e2e": "playwright test",
    "prebuild": "node scripts/compile-content.mjs && npm test",
    "format:check": "prettier --check src/App.tsx src/main.tsx src/styles.css scripts/*.mjs tests/*.ts playwright.config.ts vite.config.ts",
    "test:webkit": "node scripts/smoke-webkit.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/newsreader": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}
